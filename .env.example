# Echo Vault — this broker holds NO secrets of its own. Every credential it
# resolves lives in the canonical ECHO Master Vault ("Vault A" on FORGE,
# PyNaCl SecretBox at rest); this process only ever LOCATES + GETS through
# the SDK gate, live, per request. Agents receive vault:// references only.
# Never paste real values below into chat or commit a filled-in .env.

# Required — server-only credential this broker uses to call the vault gate.
# Never exposed to clients; never returned in any tool response.
ECHO_SDK_API_KEY=
# Optional — defaults to the public tunnel. Use the LAN address when this
# broker runs on FORGE itself: http://127.0.0.1:8000 or http://192.168.1.220:8000
ECHO_SDK_GATE_URL=https://forge.echo-op.com

# Optional caller identity for MCP (grok | chatgpt | claude | echo)
ECHO_AGENT=claude
