# Echo Vault — this broker holds NO secrets of its own. Every credential it
# resolves lives in the canonical ECHO Master Vault ("Vault A" on FORGE);
# this process only LOCATES + GETS through the SDK gate, live, per request.
# Agents receive references only. Names only below: never commit a filled-in
# .env, never paste a value into chat. See README.md for what each one does.

# --- Canonical vault gate (required) ---
ECHO_SDK_API_KEY=
ECHO_SDK_GATE_URL=

# --- Database ---
# Postgres for OAuth clients, approvals, entries, grants and the ledger.
# Required on a deployed server.
DATABASE_URL=
# Embedded database directory when DATABASE_URL is unset (stdio default: .vault-data).
ECHO_VAULT_DATA_DIR=
ECHO_VAULT_MIGRATIONS_DIR=

# --- Public origin (OAuth metadata, card links) ---
ECHO_VAULT_PUBLIC_URL=

# --- Telegram approvals and cards ---
TELEGRAM_BOT_TOKEN=
ECHO_VAULT_APPROVER_TELEGRAM_ID=
ECHO_VAULT_APPROVAL_HMAC_KEY=
ECHO_VAULT_TELEGRAM_WEBHOOK_SECRET=

# --- Ledger ---
ECHO_VAULT_LEDGER_HMAC_KEY=

# --- Entry consent grants ---
# Lifetime of a read-only consent grant (ms; default 86400000 = 24h).
ECHO_VAULT_GRANT_TTL_MS=
# Max un-prompted reads per grant (default 500; "unlimited" for no cap).
ECHO_VAULT_GRANT_MAX_USES=

# --- Policy and identities ---
ECHO_VAULT_POLICY_FILE=
ECHO_VAULT_WORKLOAD_TOKENS_FILE=
ECHO_VAULT_OAUTH_MAX_CLIENTS=
ECHO_VAULT_OAUTH_MAX_PENDING=

# --- Local stdio client ---
# Name in the ledger (local:<name>). Grants nothing.
ECHO_AGENT=
# Comma list of scopes for the local client. Empty = read-only defaults.
ECHO_VAULT_LOCAL_SCOPES=

# --- GitHub App (optional; short-lived installation tokens) ---
ECHO_VAULT_GITHUB_APP_ID_REF=
ECHO_VAULT_GITHUB_APP_KEY_REF=
ECHO_VAULT_GITHUB_INSTALLATIONS=

# --- Web console (optional) ---
# "local" enables the read-only console. Only on a private, owner-only host.
ECHO_VAULT_CONSOLE=

# --- Debug / tests ---
ECHO_VAULT_DEBUG=
ECHO_VAULT_LIVE_TESTS=
