{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "echo-vault": {
      "type": "streamable-http",
      "url": "https://credbroker.echo-op.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["vault.read"],
            "defaultScopes": ["vault.read"]
          }
        }
      }
    }
  }
}
